[{"id":1,"text":"불 좀 켜 줘.","gold":"요청(켜다(청자,불))"},{"id":2,"text":"현관문 잠갔어?","gold":"질문(잠그다(청자,현관문))"},{"id":3,"text":"세탁기가 다 돌아갔어.","gold":"알림(완료(돌다(세탁기)))"},{"id":4,"text":"빨래는 베란다에 널어 줘.","gold":"요청(널다(청자,빨래,베란다))"},{"id":5,"text":"저녁 먹기 전에 손 씻어.","gold":"요청(먼저(씻다(청자,손),먹다(청자,저녁)))"},{"id":6,"text":"냉장고에 우유가 없어.","gold":"알림(부정(있다(우유,냉장고)))"},{"id":7,"text":"내가 쓰레기 버릴게.","gold":"약속(버리다(화자,쓰레기))"},{"id":8,"text":"이건 어디에 두면 돼?","gold":"질문(허용(두다(화자,이것,장소?)))"},{"id":9,"text":"창문 열어 놔도 돼?","gold":"질문(허용(열어두다(화자,창문)))"},{"id":10,"text":"외출할 때 보일러를 꺼 줘.","gold":"요청(조건(외출하다(청자),끄다(청자,보일러)))"},{"id":11,"text":"물 한 잔 주세요.","gold":"요청(주다(청자,화자,물,한잔))"},{"id":12,"text":"아메리카노 두 잔 주세요.","gold":"요청(주다(청자,화자,아메리카노,두잔))"},{"id":13,"text":"이거 많이 매워요?","gold":"질문(맵다(이것,많이))"},{"id":14,"text":"고수는 빼 주세요.","gold":"요청(빼다(청자,고수))"},{"id":15,"text":"저는 땅콩 알레르기가 있어요.","gold":"알림(알레르기(화자,땅콩))"},{"id":16,"text":"여기서 먹고 갈게요.","gold":"선택(매장식사(화자,여기))"},{"id":17,"text":"남은 음식 포장해 주세요.","gold":"요청(포장하다(청자,남은음식))"},{"id":18,"text":"오늘 점심은 뭐 먹을까?","gold":"질문(먹다(우리,음식?,오늘점심))"},{"id":19,"text":"국이 식기 전에 먹자.","gold":"제안(먼저(먹다(우리,국),식다(국)))"},{"id":20,"text":"생선이 없으면 두부로 주세요.","gold":"요청(조건(부정(있다(생선)),주다(청자,화자,두부)))"},{"id":21,"text":"이거 얼마예요?","gold":"질문(가격(이것,금액?))"},{"id":22,"text":"카드로 계산할게요.","gold":"약속(결제하다(화자,카드))"},{"id":23,"text":"영수증 주세요.","gold":"요청(주다(청자,화자,영수증))"},{"id":24,"text":"이 옷 입어 봐도 돼요?","gold":"질문(허용(입어보다(화자,이옷)))"},{"id":25,"text":"같은 옷으로 한 치수 큰 것 있어요?","gold":"질문(있다(큰치수(이옷,한단계)))"},{"id":26,"text":"이 사과 세 개 주세요.","gold":"요청(주다(청자,화자,이사과,세개))"},{"id":27,"text":"지금 이거 할인해요?","gold":"질문(할인하다(청자,이것,지금))"},{"id":28,"text":"어제 산 걸 교환하고 싶어요.","gold":"요청(교환하다(청자,구매품(화자,어제),화자))"},{"id":29,"text":"현금으로 내면 더 싸요?","gold":"질문(조건(결제하다(화자,현금),더싸다(가격,다른결제수단기준)))"},{"id":30,"text":"이건 빼고 나머지만 계산해 주세요.","gold":"요청(결제하다(청자,제외(상품묶음,이것)))"},{"id":31,"text":"화장실이 어디예요?","gold":"질문(위치(화장실,장소?))"},{"id":32,"text":"이 버스가 서울역에 가요?","gold":"질문(가다(이버스,서울역))"},{"id":33,"text":"여기서 세워 주세요.","gold":"요청(세우다(청자,차,여기))"},{"id":34,"text":"다음 역에서 내려요.","gold":"알림(내리다(화자,다음역))"},{"id":35,"text":"이 길로 쭉 가세요.","gold":"안내(가다(청자,이길,직진))"},{"id":36,"text":"두 번째 골목에서 오른쪽으로 도세요.","gold":"안내(돌다(청자,두번째골목,오른쪽))"},{"id":37,"text":"역까지 걸어서 얼마나 걸려요?","gold":"질문(소요시간(걷다(화자,여기,역),시간?))"},{"id":38,"text":"막차는 몇 시에 출발해요?","gold":"질문(출발하다(막차,시각?))"},{"id":39,"text":"버스가 안 오면 지하철 타자.","gold":"제안(조건(부정(오다(버스)),타다(우리,지하철)))"},{"id":40,"text":"길 건너서 왼쪽에 있는 약국을 찾으세요.","gold":"안내(먼저(건너다(청자,길),찾다(청자,약국(왼쪽))))"},{"id":41,"text":"지금 통화할 수 있어?","gold":"질문(가능(통화하다(청자,화자,지금)))"},{"id":42,"text":"내일 몇 시에 만날까?","gold":"질문(만나다(우리,내일,시각?))"},{"id":43,"text":"세 시에 역 앞에서 만나자.","gold":"제안(만나다(우리,오늘오후세시,중앙역앞))"},{"id":44,"text":"나 십 분쯤 늦을 것 같아.","gold":"알림(추정(늦다(화자,십분정도)))"},{"id":45,"text":"도착하면 문자 보내 줘.","gold":"요청(조건(도착하다(청자),보내다(청자,화자,문자)))"},{"id":46,"text":"오늘 약속을 내일로 미뤄도 돼?","gold":"질문(허용(미루다(우리,오늘약속,내일)))"},{"id":47,"text":"나는 금요일보다 토요일이 편해.","gold":"알림(선호(화자,토요일,금요일))"},{"id":48,"text":"전화 못 받으면 메시지 남겨 줘.","gold":"요청(조건(불가(받다(화자,전화)),남기다(청자,메시지)))"},{"id":49,"text":"수진이가 내일 못 온대.","gold":"알림(전언(수진,불가(오다(수진,내일))))"},{"id":50,"text":"민수한테 내가 늦는다고 전해 줘.","gold":"요청(전달하다(청자,민수,늦다(화자)))"},{"id":51,"text":"자료 좀 보내 주세요.","gold":"요청(보내다(청자,화자,자료))"},{"id":52,"text":"숙제 다 했어?","gold":"질문(완료(하다(청자,숙제)))"},{"id":53,"text":"이 표는 제가 만들었어요.","gold":"알림(만들다(화자,이표))"},{"id":54,"text":"파일 이름을 바꿔 주세요.","gold":"요청(바꾸다(청자,파일이름))"},{"id":55,"text":"회의가 끝난 뒤에 전화할게요.","gold":"약속(먼저(끝나다(회의),전화하다(화자,청자)))"},{"id":56,"text":"제출하기 전에 오타를 확인해요.","gold":"안내(먼저(확인하다(청자,오타),제출하다(청자,자료)))"},{"id":57,"text":"어제 보낸 파일이 열리지 않아요.","gold":"알림(부정(열리다(보낸파일(청자,어제))))"},{"id":58,"text":"제가 먼저 할 일이 뭐예요?","gold":"질문(우선과제(화자,일?))"},{"id":59,"text":"선생님이 내일까지 내라고 했어요.","gold":"알림(전언(선생님,요청(제출하다(우리,과제,내일까지))))"},{"id":60,"text":"회의가 취소됐는지 확인해 주세요.","gold":"요청(확인하다(청자,질문(취소되다(회의))))"},{"id":61,"text":"머리가 아파요.","gold":"알림(아프다(화자,머리))"},{"id":62,"text":"어제부터 기침이 나요.","gold":"알림(기침하다(화자,어제부터))"},{"id":63,"text":"여기 앉아도 돼요?","gold":"질문(허용(앉다(화자,여기)))"},{"id":64,"text":"병원까지 같이 가 줄래요?","gold":"요청(동행하다(청자,화자,병원))"},{"id":65,"text":"얼마나 기다려야 해요?","gold":"질문(대기시간(화자,시간?))"},{"id":66,"text":"이 상자 좀 들어 줘.","gold":"요청(들다(청자,이상자))"},{"id":67,"text":"길에서 지갑을 잃어버렸어요.","gold":"알림(잃다(화자,지갑,길))"},{"id":68,"text":"도움이 필요하면 알려 줘.","gold":"요청(조건(필요하다(청자,도움),알리다(청자,화자)))"},{"id":69,"text":"어디가 불편한지 말해 주세요.","gold":"요청(말하다(청자,화자,질문(불편하다(청자,부위?))))"},{"id":70,"text":"현관 앞이 미끄러우니 조심해.","gold":"경고(이유(미끄럽다(현관앞),조심하다(청자)))"},{"id":71,"text":"그거 말고 저거 주세요.","gold":"요청(대신(주다(청자,화자,저것),주다(청자,화자,그것)))"},{"id":72,"text":"아까 그 사람 이름이 뭐였지?","gold":"질문(이름(그사람(아까),이름?))"},{"id":73,"text":"조금 천천히 말해 주세요.","gold":"요청(말하다(청자,천천히))"},{"id":74,"text":"방금 한 말 다시 해 줄래?","gold":"요청(반복하다(청자,앞발화(직전)))"},{"id":75,"text":"제가 말한 건 이번 주 금요일이에요.","gold":"정정(역할갱신(앞선만남,날짜,이번주금요일))"},{"id":76,"text":"이 번호 뒤에 0 하나 더 붙이세요.","gold":"안내(붙이다(청자,이번호,0,뒤))"},{"id":77,"text":"무슨 뜻인지 잘 모르겠어요.","gold":"알림(불확실(이해하다(화자,뜻(앞발화))))"},{"id":78,"text":"둘 중에 어느 쪽을 말한 거야?","gold":"질문(가리키다(청자,선택지?,두선택지))"},{"id":79,"text":"그 일이 끝났다는 말이야?","gold":"질문(뜻이다(앞발화,끝나다(그일)))"},{"id":80,"text":"제가 이해한 게 맞으면 고개를 끄덕여 주세요.","gold":"요청(조건(맞다(화자해석),끄덕이다(청자)))"},{"id":81,"text":"비 오면 집에 있자.","gold":"제안(조건(오다(비),있다(우리,집)))"},{"id":82,"text":"내일은 비가 안 왔으면 좋겠다.","gold":"희망(부정(오다(비,내일)))"},{"id":83,"text":"나는 차 대신 물 마실래.","gold":"알림(대신(마시다(화자,물),마시다(화자,차)))"},{"id":84,"text":"짐을 다 챙겼으면 출발하자.","gold":"제안(조건(완료(챙기다(우리,짐)),출발하다(우리)))"},{"id":85,"text":"주말에는 집에서 쉬고 싶어.","gold":"희망(쉬다(화자,집,주말))"},{"id":86,"text":"비가 와서 자전거는 두고 왔어.","gold":"알림(이유(오다(비),두고오다(화자,자전거)))"},{"id":87,"text":"지금 가면 아직 만날 수 있어.","gold":"알림(조건(가다(우리,지금),가능(아직(만나다(우리,지영)))))"},{"id":88,"text":"시간이 모자라면 첫 번째 일만 하자.","gold":"제안(조건(모자라다(시간),하다(우리,첫번째일만)))"},{"id":89,"text":"먼저 시장에 들르고 집에 가자.","gold":"제안(먼저(들르다(우리,시장),가다(우리,집)))"},{"id":90,"text":"버스를 탈지 걸어갈지 정하자.","gold":"제안(선택하다(우리,타다(우리,버스),걷다(우리)))"},{"id":91,"text":"지영이가 준 책을 민수한테 줬어.","gold":"알림(같은물건(책,먼저(주다(지영,화자,책),주다(화자,민수,책))))"},{"id":92,"text":"민수가 지영이한테 우산을 빌려줬어.","gold":"알림(빌려주다(민수,지영,우산))"},{"id":93,"text":"지영이가 민수한테 우산을 빌려줬어.","gold":"알림(빌려주다(지영,민수,우산))"},{"id":94,"text":"민수는 지영이가 열쇠를 찾았다고 생각해.","gold":"알림(생각하다(민수,찾다(지영,열쇠)))"},{"id":95,"text":"지영이는 민수가 열쇠를 찾았다고 생각해.","gold":"알림(생각하다(지영,찾다(민수,열쇠)))"},{"id":96,"text":"엄마가 네가 먼저 들어갔다고 하셨어.","gold":"알림(전언(엄마,들어가다(청자,먼저)))"},{"id":97,"text":"수진이는 민수가 문을 잠갔다는 걸 몰라.","gold":"알림(부정(알다(수진,잠그다(민수,문))))"},{"id":98,"text":"민수는 수진이가 문을 잠갔다는 걸 알아.","gold":"알림(알다(민수,잠그다(수진,문)))"},{"id":99,"text":"수진이는 민수가 자기가 늦는 걸 안다고 생각해.","gold":"알림(생각하다(수진,알다(민수,늦다(수진)))) 또는 알림(생각하다(수진,알다(민수,늦다(민수))))"},{"id":100,"text":"민수가 수진이에게 지영이가 도착했다고 말했어.","gold":"알림(전달하다(민수,수진,도착하다(지영)))"}]